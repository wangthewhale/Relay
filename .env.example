# Local development uses an in-memory store when DATABASE_URL is absent.
# Production requires a Replit PostgreSQL database.
DATABASE_URL=postgresql://user:password@host:5432/relay
PORT=5000

# Optional hybrid semantic compiler. Relay also recognizes Replit's
# AI_INTEGRATIONS_OPENAI_API_KEY and AI_INTEGRATIONS_OPENAI_BASE_URL.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
RELAY_AI_MODEL=gpt-5.6-sol
RELAY_AI_REASONING_EFFORT=low
RELAY_AI_TIMEOUT_MS=18000

# Mission invitation email. Relay reports delivery as successful only when
# Brevo returns a transactional message receipt.
BREVO_API_KEY=
RELAY_INVITE_FROM_EMAIL=business@the-wknd.club
RELAY_INVITE_FROM_NAME=Relay

# Required before any connector can be enabled. Use a long random secret and
# keep it stable; rotating it requires reauthorizing encrypted connections.
RELAY_VAULT_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
FIGMA_OAUTH_CLIENT_ID=
FIGMA_OAUTH_CLIENT_SECRET=
